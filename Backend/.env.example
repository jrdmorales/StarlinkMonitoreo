# === Base de datos ===
DATABASE_URL=postgresql://starlink:starlink_dev@localhost:5433/starlink

# === New Relic ===
NEWRELIC_API_KEY=NRAK-...          # Rotar la clave actual antes de usar
NEWRELIC_ACCOUNT_ID=7041272

# === Servidor ===
PORT=3000
NODE_ENV=development

# === Cron ===
FETCH_CRON=0 */4 * * *            # Cada 4 horas
ALERT_THRESHOLDS=50,80,100

# === Email (Fase 2) ===
SMTP_HOST=smtp.gmail.com               # o smtp.office365.com para Outlook/M365
SMTP_PORT=587
SMTP_USER=alerts@excon.cl
SMTP_PASS=                             # App password de Gmail / contraseña SMTP
SMTP_FROM=Starlink Control <alerts@excon.cl>

# === Auth admin (Fase 3) ===
# Generar JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=                        # Mínimo 32 caracteres, string aleatorio

# === Starlink API directa (opcional) ===
# Generar clave: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STARLINK_ENCRYPTION_KEY=           # 64 chars hex — requerido para cifrar credenciales
STARLINK_SYNC_CRON=0 */6 * * *    # Cada 6 horas (por defecto)

# Cuentas Starlink — JSON array, una entrada por obra
# obraId = id numérico en tabla obras | starlinkAccountId = ACC-XXXXX
STARLINK_ACCOUNTS=[{"obraId":1,"starlinkAccountId":"ACC-XXXXX","clientId":"xxx","clientSecret":"xxx"}]
